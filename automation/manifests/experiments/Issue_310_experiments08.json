{
  "schema_version": 1,
  "issue": 310,
  "sequence": 8,
  "title": "Sequence 08 Poisson architecture parity",
  "prepare_manifest": "automation/manifests/experiments/Issue_310_experiments08_prep.json",
  "bundle_paths": [
    "physics_app/physics-opt",
    "physics_app/lib/libphysics-opt.so.0",
    "physics_app/test/lib/libphysics_test-opt.so.0",
    "experiments/Issue310_fp_acceleration/generated_fp08"
  ],
  "max_parallel": 2,
  "cases": [
    {
      "id": "fullsolve_steady_picard2x",
      "name": "Reference: FullSolveMultiApp + Steady Poisson + Picard-2x; 12 electron steps / 3 heavy cycles",
      "command": [
        "python3",
        "experiments/Issue310_fp_acceleration/control_seq08.py",
        "--case",
        "fullsolve_steady_picard2x"
      ],
      "timeout_seconds": 1800,
      "artifacts": [
        "experiments/Issue310_fp_acceleration/results_fp08/fullsolve_steady_picard2x_returncode.txt",
        "experiments/Issue310_fp_acceleration/results_fp08/fullsolve_steady_picard2x_elapsed_seconds.txt",
        "experiments/Issue310_fp_acceleration/results_fp08/fullsolve_steady_picard2x_runtime_tail.log",
        "experiments/Issue310_fp_acceleration/results_fp08/fullsolve_steady_picard2x_result.json",
        "experiments/Issue310_fp_acceleration/generated_fp08/fullsolve_steady_picard2x/input_step_csv.csv",
        "experiments/Issue310_fp_acceleration/generated_fp08/fullsolve_steady_picard2x/input_out_electron0_step_csv.csv",
        "experiments/Issue310_fp_acceleration/generated_fp08/fullsolve_steady_picard2x/*profile_*.csv"
      ]
    },
    {
      "id": "transient_timeaware_picard2x",
      "name": "Trial: TransientMultiApp + Transient Poisson + Picard-2x; 12 electron steps / 3 heavy cycles",
      "command": [
        "python3",
        "experiments/Issue310_fp_acceleration/control_seq08.py",
        "--case",
        "transient_timeaware_picard2x"
      ],
      "timeout_seconds": 1800,
      "artifacts": [
        "experiments/Issue310_fp_acceleration/results_fp08/transient_timeaware_picard2x_returncode.txt",
        "experiments/Issue310_fp_acceleration/results_fp08/transient_timeaware_picard2x_elapsed_seconds.txt",
        "experiments/Issue310_fp_acceleration/results_fp08/transient_timeaware_picard2x_runtime_tail.log",
        "experiments/Issue310_fp_acceleration/results_fp08/transient_timeaware_picard2x_result.json",
        "experiments/Issue310_fp_acceleration/generated_fp08/transient_timeaware_picard2x/input_step_csv.csv",
        "experiments/Issue310_fp_acceleration/generated_fp08/transient_timeaware_picard2x/input_out_electron0_step_csv.csv",
        "experiments/Issue310_fp_acceleration/generated_fp08/transient_timeaware_picard2x/*profile_*.csv"
      ]
    }
  ],
  "aggregate": {
    "name": "Aggregate architecture parity evidence",
    "command": [
      "python3",
      "experiments/Issue310_fp_acceleration/control_seq08.py",
      "--aggregate"
    ],
    "timeout_seconds": 300,
    "artifacts": [
      "experiments/Issue310_fp_acceleration/results_fp08/issue310_fp08_summary.json"
    ]
  }
}
