{
  "schema_version": 1,
  "issue": 306,
  "sequence": 5,
  "title": "100/200/300-cycle heavy-relaxation convergence at fixed chi_e=20",
  "prepare_manifest": "automation/manifests/experiments/Issue_306_experiments05_prep.json",
  "bundle_paths": [
    "physics_app/physics-opt",
    "physics_app/lib/libphysics-opt.so.0",
    "physics_app/test/lib/libphysics_test-opt.so.0",
    "experiments/Issue306_heavy_charge_motion/generated_wall05"
  ],
  "max_parallel": 3,
  "cases": [
    {
      "id": "comsol_cycles100",
      "name": "comsol_cycles100 long-relaxation case",
      "command": [
        "python3",
        "experiments/Issue306_heavy_charge_motion/wall05_control.py",
        "--case",
        "comsol_cycles100"
      ],
      "timeout_seconds": 7200,
      "artifacts": [
        "experiments/Issue306_heavy_charge_motion/results_wall05/comsol_cycles100_runtime.log",
        "experiments/Issue306_heavy_charge_motion/results_wall05/comsol_cycles100_returncode.txt",
        "experiments/Issue306_heavy_charge_motion/results_wall05/comsol_cycles100_elapsed_seconds.txt",
        "experiments/Issue306_heavy_charge_motion/results_wall05/comsol_cycles100_result.json",
        "experiments/Issue306_heavy_charge_motion/generated_wall05/comsol_cycles100/**/*.csv",
        "experiments/Issue306_heavy_charge_motion/generated_wall05/comsol_cycles100/**/*.e"
      ]
    },
    {
      "id": "comsol_cycles200",
      "name": "comsol_cycles200 long-relaxation case",
      "command": [
        "python3",
        "experiments/Issue306_heavy_charge_motion/wall05_control.py",
        "--case",
        "comsol_cycles200"
      ],
      "timeout_seconds": 7200,
      "artifacts": [
        "experiments/Issue306_heavy_charge_motion/results_wall05/comsol_cycles200_runtime.log",
        "experiments/Issue306_heavy_charge_motion/results_wall05/comsol_cycles200_returncode.txt",
        "experiments/Issue306_heavy_charge_motion/results_wall05/comsol_cycles200_elapsed_seconds.txt",
        "experiments/Issue306_heavy_charge_motion/results_wall05/comsol_cycles200_result.json",
        "experiments/Issue306_heavy_charge_motion/generated_wall05/comsol_cycles200/**/*.csv",
        "experiments/Issue306_heavy_charge_motion/generated_wall05/comsol_cycles200/**/*.e"
      ]
    },
    {
      "id": "comsol_cycles300",
      "name": "comsol_cycles300 long-relaxation case",
      "command": [
        "python3",
        "experiments/Issue306_heavy_charge_motion/wall05_control.py",
        "--case",
        "comsol_cycles300"
      ],
      "timeout_seconds": 7200,
      "artifacts": [
        "experiments/Issue306_heavy_charge_motion/results_wall05/comsol_cycles300_runtime.log",
        "experiments/Issue306_heavy_charge_motion/results_wall05/comsol_cycles300_returncode.txt",
        "experiments/Issue306_heavy_charge_motion/results_wall05/comsol_cycles300_elapsed_seconds.txt",
        "experiments/Issue306_heavy_charge_motion/results_wall05/comsol_cycles300_result.json",
        "experiments/Issue306_heavy_charge_motion/generated_wall05/comsol_cycles300/**/*.csv",
        "experiments/Issue306_heavy_charge_motion/generated_wall05/comsol_cycles300/**/*.e"
      ]
    }
  ],
  "aggregate": {
    "name": "Aggregate 100/200/300-cycle potential convergence",
    "command": [
      "python3",
      "experiments/Issue306_heavy_charge_motion/wall05_control.py",
      "--aggregate"
    ],
    "timeout_seconds": 300,
    "artifacts": [
      "experiments/Issue306_heavy_charge_motion/results_wall05/issue306_wall05_summary.json"
    ]
  }
}
