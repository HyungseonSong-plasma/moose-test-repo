{
  "schema_version": 1,
  "issue": 310,
  "sequence": 1,
  "title": "Fixed-point relaxation-factor optimization at chi_e=100 and chi_h=400",
  "prepare_manifest": "automation/manifests/experiments/Issue_310_experiments01_prep.json",
  "bundle_paths": [
    "physics_app/physics-opt",
    "physics_app/lib/libphysics-opt.so.0",
    "physics_app/test/lib/libphysics_test-opt.so.0",
    "experiments/Issue310_relaxation_optimization/generated_relaxation01"
  ],
  "max_parallel": 3,
  "cases": [
    {
      "id": "relax_1x",
      "name": "1/(1+chi) baseline",
      "command": [
        "python3",
        "experiments/Issue310_relaxation_optimization/control.py",
        "--case",
        "relax_1x"
      ],
      "timeout_seconds": 7200,
      "artifacts": [
        "experiments/Issue310_relaxation_optimization/results_relaxation01/relax_1x_returncode.txt",
        "experiments/Issue310_relaxation_optimization/results_relaxation01/relax_1x_elapsed_seconds.txt",
        "experiments/Issue310_relaxation_optimization/results_relaxation01/relax_1x_runtime_tail.log",
        "experiments/Issue310_relaxation_optimization/results_relaxation01/relax_1x_result.json",
        "experiments/Issue310_relaxation_optimization/generated_relaxation01/relax_1x/input_step_csv.csv",
        "experiments/Issue310_relaxation_optimization/generated_relaxation01/relax_1x/input_out_electron0_step_csv.csv",
        "experiments/Issue310_relaxation_optimization/generated_relaxation01/relax_1x/*profile_*.csv"
      ]
    },
    {
      "id": "relax_2x",
      "name": "2/(1+chi) candidate",
      "command": [
        "python3",
        "experiments/Issue310_relaxation_optimization/control.py",
        "--case",
        "relax_2x"
      ],
      "timeout_seconds": 7200,
      "artifacts": [
        "experiments/Issue310_relaxation_optimization/results_relaxation01/relax_2x_returncode.txt",
        "experiments/Issue310_relaxation_optimization/results_relaxation01/relax_2x_elapsed_seconds.txt",
        "experiments/Issue310_relaxation_optimization/results_relaxation01/relax_2x_runtime_tail.log",
        "experiments/Issue310_relaxation_optimization/results_relaxation01/relax_2x_result.json",
        "experiments/Issue310_relaxation_optimization/generated_relaxation01/relax_2x/input_step_csv.csv",
        "experiments/Issue310_relaxation_optimization/generated_relaxation01/relax_2x/input_out_electron0_step_csv.csv",
        "experiments/Issue310_relaxation_optimization/generated_relaxation01/relax_2x/*profile_*.csv"
      ]
    },
    {
      "id": "relax_5x",
      "name": "5/(1+chi) candidate",
      "command": [
        "python3",
        "experiments/Issue310_relaxation_optimization/control.py",
        "--case",
        "relax_5x"
      ],
      "timeout_seconds": 7200,
      "artifacts": [
        "experiments/Issue310_relaxation_optimization/results_relaxation01/relax_5x_returncode.txt",
        "experiments/Issue310_relaxation_optimization/results_relaxation01/relax_5x_elapsed_seconds.txt",
        "experiments/Issue310_relaxation_optimization/results_relaxation01/relax_5x_runtime_tail.log",
        "experiments/Issue310_relaxation_optimization/results_relaxation01/relax_5x_result.json",
        "experiments/Issue310_relaxation_optimization/generated_relaxation01/relax_5x/input_step_csv.csv",
        "experiments/Issue310_relaxation_optimization/generated_relaxation01/relax_5x/input_out_electron0_step_csv.csv",
        "experiments/Issue310_relaxation_optimization/generated_relaxation01/relax_5x/*profile_*.csv"
      ]
    }
  ],
  "aggregate": {
    "name": "Aggregate relaxation-factor performance and parity evidence",
    "command": [
      "python3",
      "experiments/Issue310_relaxation_optimization/control.py",
      "--aggregate"
    ],
    "timeout_seconds": 300,
    "artifacts": [
      "experiments/Issue310_relaxation_optimization/results_relaxation01/issue310_relaxation01_summary.json"
    ]
  }
}
