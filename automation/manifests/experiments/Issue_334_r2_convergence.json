{
  "schema_version": 1,
  "issue": 334,
  "sequence": 1,
  "title": "R2 custom vs standard convergence short A/B",
  "prepare_manifest": "automation/manifests/experiments/Issue_334_r2_convergence_prep.json",
  "bundle_paths": [
    "physics_app/physics-opt",
    "physics_app/lib/libphysics-opt.so.0",
    "physics_app/test/lib/libphysics_test-opt.so.0",
    "experiments/Issue334_standard_convergence/generated_r2"
  ],
  "max_parallel": 1,
  "cases": [
    {
      "id": "short_ab",
      "name": "short_ab",
      "command": [
        "python3",
        "experiments/Issue334_standard_convergence/control.py",
        "--case",
        "short_ab"
      ],
      "timeout_seconds": 1800,
      "artifacts": [
        "experiments/Issue334_standard_convergence/results_r2/*",
        "experiments/Issue334_standard_convergence/generated_r2/custom_convergence/*csv",
        "experiments/Issue334_standard_convergence/generated_r2/standard_convergence/*csv"
      ]
    }
  ],
  "aggregate": {
    "name": "Aggregate R2 short discriminator",
    "command": [
      "python3",
      "experiments/Issue334_standard_convergence/control.py",
      "--aggregate"
    ],
    "timeout_seconds": 300,
    "artifacts": [
      "r2_aggregate.json"
    ]
  }
}
