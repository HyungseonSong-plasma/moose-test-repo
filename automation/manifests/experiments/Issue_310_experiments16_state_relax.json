{
  "schema_version": 1,
  "issue": 310,
  "sequence": 16,
  "title": "Generation 16 state-dependent Jacobian plus band5 relaxation discriminator",
  "prepare_manifest": "automation/manifests/experiments/Issue_310_experiments16_state_relax_prep.json",
  "bundle_paths": [
    "physics_app/physics-opt",
    "physics_app/lib/libphysics-opt.so.0",
    "physics_app/test/lib/libphysics_test-opt.so.0",
    "experiments/Issue310_fp_acceleration/generated_fp16_state_jacobian",
    "experiments/Issue310_fp_acceleration/generated_fp16_relax"
  ],
  "max_parallel": 6,
  "cases": [
    {
      "id": "state_jacobian",
      "name": "Direct t1-t2-t3 state-dependent basis Jacobian",
      "command": ["python3", "experiments/Issue310_fp_acceleration/control_seq16_state_jacobian.py", "--case"],
      "timeout_seconds": 5400,
      "artifacts": [
        "experiments/Issue310_fp_acceleration/results_fp16_state_jacobian/**"
      ]
    },
    {
      "id": "picard2x_control",
      "name": "Qualified time-aware Picard-2x control",
      "command": ["python3", "experiments/Issue310_fp_acceleration/control_seq16_relax.py", "--case", "picard2x_control"],
      "timeout_seconds": 1800,
      "artifacts": [
        "experiments/Issue310_fp_acceleration/results_fp16_relax/picard2x_control_*",
        "experiments/Issue310_fp_acceleration/generated_fp16_relax/picard2x_control/*csv"
      ]
    },
    {
      "id": "band5_alpha002",
      "name": "Band5 Jacobian alpha 0.02",
      "command": ["python3", "experiments/Issue310_fp_acceleration/control_seq16_relax.py", "--case", "band5_alpha002"],
      "timeout_seconds": 1800,
      "artifacts": [
        "experiments/Issue310_fp_acceleration/results_fp16_relax/band5_alpha002_*",
        "experiments/Issue310_fp_acceleration/generated_fp16_relax/band5_alpha002/*csv"
      ]
    },
    {
      "id": "band5_alpha005",
      "name": "Band5 Jacobian alpha 0.05",
      "command": ["python3", "experiments/Issue310_fp_acceleration/control_seq16_relax.py", "--case", "band5_alpha005"],
      "timeout_seconds": 1800,
      "artifacts": [
        "experiments/Issue310_fp_acceleration/results_fp16_relax/band5_alpha005_*",
        "experiments/Issue310_fp_acceleration/generated_fp16_relax/band5_alpha005/*csv"
      ]
    },
    {
      "id": "band5_alpha010",
      "name": "Band5 Jacobian alpha 0.10",
      "command": ["python3", "experiments/Issue310_fp_acceleration/control_seq16_relax.py", "--case", "band5_alpha010"],
      "timeout_seconds": 1800,
      "artifacts": [
        "experiments/Issue310_fp_acceleration/results_fp16_relax/band5_alpha010_*",
        "experiments/Issue310_fp_acceleration/generated_fp16_relax/band5_alpha010/*csv"
      ]
    },
    {
      "id": "band5_alpha020",
      "name": "Band5 Jacobian alpha 0.20",
      "command": ["python3", "experiments/Issue310_fp_acceleration/control_seq16_relax.py", "--case", "band5_alpha020"],
      "timeout_seconds": 1800,
      "artifacts": [
        "experiments/Issue310_fp_acceleration/results_fp16_relax/band5_alpha020_*",
        "experiments/Issue310_fp_acceleration/generated_fp16_relax/band5_alpha020/*csv"
      ]
    }
  ],
  "aggregate": {
    "name": "Aggregate Gen16 state-Jacobian and relaxation evidence",
    "command": ["python3", "experiments/Issue310_fp_acceleration/control_seq16_aggregate.py", "--aggregate"],
    "timeout_seconds": 300,
    "artifacts": [
      "experiments/Issue310_fp_acceleration/results_fp16_combined/issue310_gen16_combined_summary.json"
    ]
  }
}
