{
  "schema_version": 1,
  "issue": 336,
  "sequence": 1,
  "title": "R2b custom vs scalarized standard convergence short A/B",
  "prepare_manifest": "automation/manifests/experiments/Issue_336_r2b_scalar_convergence_prep.json",
  "bundle_paths": [
    "physics_app/physics-opt",
    "physics_app/lib/libphysics-opt.so.0",
    "physics_app/test/lib/libphysics_test-opt.so.0",
    "experiments/Issue336_standard_scalarized_convergence/generated_r2b"
  ],
  "max_parallel": 1,
  "cases": [
    {
      "id": "short_ab",
      "name": "short_ab",
      "command": [
        "python3",
        "experiments/Issue336_standard_scalarized_convergence/control.py",
        "--case",
        "short_ab"
      ],
      "timeout_seconds": 1800,
      "artifacts": [
        "experiments/Issue336_standard_scalarized_convergence/results_r2b/*",
        "experiments/Issue336_standard_scalarized_convergence/generated_r2b/custom_and/*csv",
        "experiments/Issue336_standard_scalarized_convergence/generated_r2b/standard_scalar_and/*csv"
      ]
    }
  ],
  "aggregate": {
    "name": "Aggregate R2b short discriminator",
    "command": [
      "python3",
      "experiments/Issue336_standard_scalarized_convergence/control.py",
      "--aggregate"
    ],
    "timeout_seconds": 300,
    "artifacts": [
      "r2b_aggregate.json"
    ]
  }
}
