{
  "schema_version": 1,
  "repository": "HyungseonSong-plasma/moose-test-repo",
  "mutation": {
    "allow": {
      "file": [
        "create",
        "update",
        "delete"
      ],
      "branch": [
        "create"
      ]
    },
    "file_paths": {
      "allow": [
        "**"
      ],
      "deny": [
        ".github/workflows/**",
        ".github/actions/**"
      ]
    },
    "branch_names": {
      "allow": [
        "issue-*",
        "cleanup-*"
      ],
      "deny": [
        "main",
        "master"
      ]
    }
  },
  "validation_gate": {
    "mode": "named_workflows",
    "workflows": [
      "Repository CI"
    ],
    "ignore_current_run": true
  }
}
