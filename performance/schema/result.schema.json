{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/qpx/performance/result.schema.json",
  "title": "QPX Normalized Performance Result",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version", "run_id", "experiment_id", "case_id", "mode",
    "identity", "environment", "problem", "work", "performance",
    "validation", "evidence"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "run_id": {"type": "string", "minLength": 1},
    "experiment_id": {"type": "string", "minLength": 1},
    "case_id": {"type": "string", "minLength": 1},
    "mode": {"enum": ["BENCHMARK", "PROFILE"]},
    "identity": {
      "type": "object",
      "required": ["input_sha256", "qpx_realpath", "executable_sha256"],
      "properties": {
        "input_sha256": {"type": "string", "minLength": 1},
        "qpx_realpath": {"type": "string", "minLength": 1},
        "executable_sha256": {"type": "string", "minLength": 1},
        "manifest_sha256": {"type": ["string", "null"]},
        "overlay_sha256": {"type": ["string", "null"]}
      }
    },
    "environment": {
      "type": "object",
      "required": ["hostname", "platform", "python"],
      "properties": {
        "hostname": {"type": "string", "minLength": 1},
        "platform": {"type": "string", "minLength": 1},
        "python": {"type": "string", "minLength": 1},
        "system": {"type": ["string", "null"]},
        "machine": {"type": ["string", "null"]},
        "processor": {"type": ["string", "null"]},
        "logical_cpu_count": {"type": ["integer", "null"], "minimum": 1},
        "mpi_ranks": {"type": ["integer", "null"], "minimum": 1},
        "threads": {"type": ["integer", "null"], "minimum": 1},
        "moose": {"type": ["string", "null"]},
        "libmesh": {"type": ["string", "null"]},
        "petsc": {"type": ["string", "null"]},
        "slepc": {"type": ["string", "null"]}
      }
    },
    "problem": {
      "type": "object",
      "properties": {
        "nodes": {"type": ["integer", "null"], "minimum": 0},
        "elements": {"type": ["integer", "null"], "minimum": 0},
        "dofs": {"type": ["integer", "null"], "minimum": 0},
        "variables": {"type": ["array", "null"], "items": {"type": "string"}},
        "species": {"type": ["array", "null"], "items": {"type": "string"}}
      }
    },
    "work": {
      "type": "object",
      "properties": {
        "nonlinear_iterations": {"type": ["integer", "null"], "minimum": 0},
        "linear_iterations": {"type": ["integer", "null"], "minimum": 0},
        "residual_evaluations": {"type": ["integer", "null"], "minimum": 0},
        "jacobian_evaluations": {"type": ["integer", "null"], "minimum": 0}
      }
    },
    "performance": {
      "type": "object",
      "properties": {
        "wall_seconds": {"type": ["number", "null"], "minimum": 0},
        "max_memory_mb": {"type": ["number", "null"], "minimum": 0},
        "perfgraph": {"type": ["object", "null"]},
        "petsc": {"type": ["object", "null"]}
      }
    },
    "validation": {
      "type": "object",
      "required": ["status", "p2_returncode", "p3_returncode"],
      "properties": {
        "status": {
          "enum": [
            "P2_PASS_P3_PASS",
            "HARNESS_OR_CONSTRUCTION_FAIL",
            "RUNTIME_FAIL_OR_NONCONVERGENCE"
          ]
        },
        "p2_returncode": {"type": ["integer", "null"]},
        "p3_returncode": {"type": ["integer", "null"]},
        "physics_parameters_changed": {"type": "boolean"},
        "solver_tolerances_changed": {"type": "boolean"},
        "bounded_num_steps_override": {"type": "integer", "minimum": 1}
      }
    },
    "evidence": {"type": "object"}
  }
}
