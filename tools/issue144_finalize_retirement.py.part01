t MOOSE input-mutation schema and immutable mutation plan IR."""\nfrom .compiler import compile_mutation_spec\nfrom .errors import MutationSpecDependencyError, MutationSpecError, SpecProblem\nfrom .loader import load_mutation_json_file, load_mutation_json_text, load_mutation_payload\nfrom .models import (\n    AddPetscFlagsOperation, EnsureBlockOperation, InsertChildBlockOperation,\n    InsertTopLevelBeforeOperation, MutationCaseSpec, MutationSpec, RemoveBlockOperation,\n    RemovePathsOperation, RemovePetscFlagsOperation, RemovePetscOptionOperation,\n    ReplaceBlockOperation, SetParameterOperation, SetPetscOptionOperation, pydantic_major_api,\n)\nfrom .plan import MutationCasePlan, MutationPlan, OperationPlan\n__all__ = [\n    "AddPetscFlagsOperation", "EnsureBlockOperation", "InsertChildBlockOperation",\n    "InsertTopLevelBeforeOperation", "MutationCasePlan", "MutationCaseSpec",\n    "MutationPlan", "MutationSpec", "MutationSpecDependencyError", "MutationSpecError",\n    "OperationPlan", "RemoveBlockOperation", "RemovePathsOperation",\n    "RemovePetscFlagsOperation", "RemovePetscOptionOperation", "ReplaceBlockOperation",\n    "SetParameterOperation", "SetPetscOptionOperation", "SpecProblem",\n    "compile_mutation_spec", "load_mutation_json_file", "load_mutation_json_text",\n    "load_mutation_payload", "pydantic_major_api",\n]\n''')
# update old-spec callers with explicit API renames
files=list((ROOT/'qpx_harness').rglob('*.py'))+list((ROOT/'tests').rglob('*.py'))+list((ROOT/'experiments').rglob('*.py'))+list((ROOT/'recipes').rglob('*.py'))
for p in files:
    text=p.read_text(); old=text
    if 'qpx_harness.spec' in text or 'from ..spec.plan' in text:
        text=text.replace('from qpx_harness.spec.cases import QVT_PREPOISSON_CASE','from qpx_harness.provenance.cases import QVT_PREPOISSON_CASE')
        text=text.replace('from qpx_harness.spec import (','from qpx_harness.adapters.moose.mutation_spec import (')
        text=text.replace('from qpx_harness.spec import ', 'from qpx_harness.adapters.moose.mutation_spec import ')
        text=text.replace('from qpx_harness.spec.plan import ', 'from qpx_harness.adapters.moose.mutation_spec.plan import ')
        text=text.replace('from ..spec.plan import ', 'from ..adapters.moose.mutation_spec.plan import ')
        # symbols only in these old-spec dependent files
        replacements={
            'ExperimentSpecError':'MutationSpecError','compile_spec':'compile_mutation_spec',
            'load_json_file':'load_mutation_json_file','load_json_text':'load_mutation_json_text',
            'load_payload':'load_mutation_payload','CasePlan':'MutationCasePlan','ExecutionPlan':'MutationPlan',
        }
        for a,b in replacements.items(): text=text.replace(a,b)
    if text!=old: p.write_text(text)
# historical guard source-root path old spec
for p in (ROOT/'experiments').rglob('*.py'):
    text=p.read_text(); old=text
    text=text.replace('ROOT / "qpx_harness" / "spec"', 'ROOT / "qpx_harness" / "adapters" / "moose" / "mutation_spec"')
    if text!=old: p.write_text(text)
rm('qpx_harness/spec')

# application control model rename so semantic ExperimentSpec has one class owner
for p in list((ROOT/'qpx_harness/application').rglob('*.py'))+[ROOT/'tests/architecture/test_experiment_execution_options.py']:
    if not p.exists(): continue
    t=p.read_text(); old=t
    # preserve semantic prose in gateway/protocol comments except symbol occurrences; these files refer application type
    t=t.replace('from .experiment_spec import ExperimentSpec', 'from .experiment_spec import ExperimentControl')
    t=t.replace('from qpx_harness.application.experiment_spec import ExperimentSpec', 'from qpx_harness.application.experiment_spec import ExperimentControl')
    t=t.replace('CaseSource, ExperimentSpec, load_experiment_spec', 'CaseSource, ExperimentControl, load_experiment_spec')
    if p.name=='experiment_spec.py':
        t=t.replace('class ExperimentSpec:', 'class ExperimentControl:')
        t=t.replace('-> ExperimentSpec:', '-> ExperimentControl:')
        t=t.replace('return ExperimentSpec(', 'return ExperimentControl(')
        t=t.replace('"ExperimentSpec"', '"ExperimentControl"')
    else:
        # symbol type usages in application control modules/tests
        t=re.sub(r'\bExperimentSpec\b', 'ExperimentControl', t)
    if t!=old: p.write_text(t)

# --- R6 production canonicalization: feedback/closure and first-linear ---
# feedback relaxation construction only (everything before runtime CSV interpretation)
src=read('recipes/issue43_fast_relaxation.py')
cut=src.index('\ndef find_relaxation_csv')
head=src[:cut]
head=head.replace('"""Issue #43 fast electron + bulk-Poisson relaxation recipe semantics.\n\nThis module owns experiment-specific input construction and relaxation-evidence\ninterpretation. Runtime orchestration, filesystem staging, and executable policy\nremain in qpx_harness.\n"""','"""Reusable MOOSE construction for closed electron/bulk-Poisson feedback."""')
head=head.replace('import csv\n','').replace('import math\n','').replace('from pathlib import Path\n','')
write('qpx_harness/adapters/moose/electron_inventory/feedback_relaxation.py',head)
# feedback basis canonical
s=read('recipes/issue43_feedback_basis.py')
s=s.replace('Accepted Issue43 closed electron/bulk-Poisson feedback basis.','Canonical closed electron/bulk-Poisson feedback construction basis.')
s=s.replace('This recipe owns the scientific composition of the accepted feedback model.','This adapter composes the accepted feedback construction from reusable MOOSE mechanics.')
s=s.replace('from recipes import issue43_fast_relaxation as fast_relaxation','from . import feedback_relaxation as fast_relaxation')
write('qpx_harness/adapters/moose/electron_inventory/feedback_basis.py',s)
# closure constraint construction-only module
write('qpx_harness/adapters/moose/electron_inventory/constraint.py', '''"""MOOSE realization of the electron-inventory integral constraint."""\nfrom __future__ import annotations\nfrom qpx_harness.moose import blocks as mb\nfrom qpx_harness.moose import parameters as mp\nfrom .constants import CONSTRAINT_TYPE, LAMBDA_VARIABLE, MACRO_AVG_POSTPROCESSOR\n\ndef _ensure_debug_block(text: str) -> str:\n    if not mb.has_block(text, "Debug"):\n        return mb.append_top_level_block(text, "[Debug]\\n  show_var_residual_norms = true\\n[]")\n    return mp.upsert_parameter(text, "Debug", "show_var_residual_norms", "true")\n\ndef build_constrained_quasisteady_input(feedback_text: str, *, macro_avg: float, runtime_observability: bool = True) -> str:\n    text = mb.remove_block(feedback_text, "FVKernels/time")\n    text = mb.insert_child_block(text, "Variables", f"""  [{LAMBDA_VARIABLE}]\n    type = MooseVariableScalar\n  []""")\n    text = mb.insert_child_block(text, "Postprocessors", f"""  [{MACRO_AVG_POSTPROCESSOR}]\n    type = ConstantPostprocessor\n    value = {macro_avg:.17g}\n    outputs = none\n  []""")\n    text = mb.insert_child_block(te