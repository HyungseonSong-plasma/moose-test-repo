s=s.replace('from recipes import issue43_feedback_basis as feedback_basis','from . import feedback_basis')
s=s.replace('from recipes import issue45_inventory_constraint as inventory_constraint','from . import constraint as inventory_constraint')
write('qpx_harness/adapters/moose/electron_inventory/closure_basis.py',s)

