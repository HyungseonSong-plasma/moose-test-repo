# Update known historical guard that encoded pre-retirement ownership assertions.
write('experiments/Issue43_45_science_refactor/final_guard.py', r'''#!/usr/bin/env python3
"""Static gate for canonicalized Issue43/Issue45 science ownership after #144."""
from __future__ import annotations
import ast, sys
from pathlib import Path
ROOT = Path(__file__).resolve().parents[2]
