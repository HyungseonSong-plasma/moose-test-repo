# P2-only: construct all five Physics actions with JSON-owned electron
# continuity/energy, original signed Chemistry source, Poisson and Maxwell.
# This is NOT the baseline diffusion numerical-parity control or S6 science.
[Mesh]
  type = GeneratedMesh
  dim = 1
  nx = 4
[]
[Problem]
  solve = false
  kernel_coverage_check = false
[]
[Variables]
  # RF imaginary state is external; plasma log states are generated by Physics.
  [u_rf_imag]
    family = LAGRANGE
    order = FIRST
  []
[]
[FunctorMaterials]
  # Synthetic P2 progress values only; not real electron-impact tables.
  [synthetic_progress]
    type = ADGenericFunctorMaterial
    prop_names = 'R_EI405 R_EI406'
    prop_values = '1 2'
  []
[]
[Physics]
  [Plasmas]
    files = plasma_two_channels.json
    [Transport]
      [Chemistry]
      []
      [DriftDiffusion]
        [Continuity]
          fem_species = 'e'
          fem_potential = potential
        []
        [Energy]
          fem_species = 'e'
          fem_potential = potential
          initial_molar_energy_density_eV = 4.98161720152154e-8
        []
      []
    []
    [Poisson]
      fem_potential = potential
      initial_potential_V = 0
    []
    [Maxwell]
      field_real = potential
      field_imag = u_rf_imag
      frequency_hz = 13560000
    []
  []
[]
[Executioner]
  type = Transient
  dt = 1e-6
  num_steps = 1
[]
