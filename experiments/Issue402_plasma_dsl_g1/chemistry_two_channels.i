# Synthetic **P2 construction only**; EI-405/EI-406 identifiers here
# are illustrative, not verified physical reaction-channel assignments.
[Mesh]
  type = GeneratedMesh
  dim = 1
  nx = 4
[]
# Electron continuity is created from species.e.initial_number_density in JSON.
# log_e_energy is also generated by DDEnergyEq from synthetic positive molar
# energy density; the existing potential probe remains an independent variable.
[Variables]
  [potential]
    family = LAGRANGE
    order = FIRST
    initial_condition = 0
  []
[]
[Kernels]
  [potential_probe]
    type = Diffusion
    variable = potential
  []
[]
[Physics]
  [Plasmas]
    files = plasma_two_channels.json
    [Transport]
      [Chemistry]
      []
      [DriftDiffusion]
        [Continuity]
          fem_species = 'e'
          fem_potential = potential
        []
        [Energy]
          fem_species = 'e'
          initial_molar_energy_density_eV = 4.98161720152154e-8
        []
      []
    []
  []
[]
[FunctorMaterials]
  [synthetic_progress_and_transport]
    type = ADGenericFunctorMaterial
    prop_names = 'R_EI405 R_EI406'
    prop_values = '1 2'
  []
[]
[Executioner]
  type = Transient
  dt = 1e-6
  num_steps = 1
[]
